generator client {
provider = "prisma-client-js"
}

datasource db {
provider = "postgresql"
url = env("DATABASE_URL")
}

model Company {
id String @id @default(cuid())
name String
users User[]
}

model User {
id String @id @default(cuid())
email String @unique
password String
companyId String
company Company @relation(fields: [companyId], references: [id])
}

model ObservatorySnapshot {
  id String @id @default(cuid())
  createdAt DateTime @default(now())
  status String
  totalEvents Int
  sourcesJson String @db.Text
  summaryJson String @db.Text
  @@index([createdAt])
}

model ObservatoryEvent {
  id String @id @default(cuid())
  source String
  sourceEventId String
  title String
  eventType String?
  latitude Float?
  longitude Float?
  magnitude Float?
  firstSeenAt DateTime @default(now())
  lastSeenAt DateTime @default(now())
  lastReportedAt DateTime?
  state String @default("observed")
  @@unique([source, sourceEventId])
  @@index([lastSeenAt])
}

model ObservatoryChange {
  id String @id @default(cuid())
  createdAt DateTime @default(now())
  eventId String
  changeType String
  detailsJson String @db.Text
  @@index([createdAt])
  @@index([eventId])
}
